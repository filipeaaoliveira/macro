    "/runs/{id}/steps/{seq}/answer": {
      "post": {
        "tags": ["factory"],
        "summary": "Answer, as the caller, the Gate one of their Runs waits on. The Run\ngoes on once its workflow took the answer; reading the Run shows the\nanswer once it is recorded. A Gate asks a person: only the owner's own\nsigned-in session answers it (403 otherwise).",
        "operationId": "answer_factory_gate",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "The Run's id.",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/RunId"
            }
          },
          {
            "name": "seq",
            "in": "path",
            "description": "The place, among the Run's Steps, of the Step whose Gate it answers.",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32",
              "minimum": 0
            }
          }
        ],
        "requestBody": {
          "content": {
