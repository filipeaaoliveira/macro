    "/insights": {
      "get": {
        "tags": ["factory"],
        "summary": "How the caller's own Runs went over a period: Runs by day, outcome and\nFlow, how long Runs and Steps took, how often each entry failed or was\nvisited again, and the tokens their agents used. At most the newest\n1,000 Runs of the period are read.",
        "operationId": "get_factory_insights",
        "parameters": [
          {
            "name": "from",
            "in": "query",
            "description": "The period's first day, `YYYY-MM-DD`.",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "to",
            "in": "query",
            "description": "Its last day, included. The period lasts at most 366 days.",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "timeZone",
            "in": "query",
            "description": "The IANA time zone the days are in, such as `Europe/Lisbon`.",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "flow",
            "in": "query",
            "description": "A built-in Flow's name, to read only its Runs.",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunInsights"
                }
              }
            }
          },
          "400": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
