  "components": {
    "schemas": {
      "AnswerGateRequest": {
        "type": "object",
        "description": "Request body for answering a Gate.",
        "required": ["answer"],
        "properties": {
          "answer": {
            "$ref": "#/components/schemas/Outcome",
            "description": "The answer, one the Gate offers."
          },
          "note": {
            "type": ["string", "null"],
            "description": "What the person adds, for the Run's later Steps to read."
          }
        }
      },
      "CreateRunRequest": {
        "type": "object",
        "description": "Request body for creating a Run.",
        "required": ["flow", "request"],
        "properties": {
          "flow": {
            "type": "string",
            "description": "The name of the built-in Flow the Run walks, one `GET /flows` lists."
          },
          "repoUrl": {
            "type": ["string", "null"],
            "description": "The GitHub repository the Run works on, as its\n`https://github.com/owner/name` URL: required by a Flow that works\non one, such as `code`, and refused by the others. The caller's\nlinked GitHub account must reach it."
          },
          "request": {
            "type": "string",
            "description": "What the Run is asked to do."
          },
          "taskId": {
            "type": ["string", "null"],
            "format": "uuid",
            "description": "The Macro task the Run works on: its task document's id."
          }
        }
      },
      "DurationStats": {
        "type": "object",
        "description": "A spread of durations: how many, their median and 90th percentile.",
        "required": ["count", "medianSeconds", "p90Seconds"],
        "properties": {
          "count": {
            "type": "integer",
            "format": "int32",
            "description": "How many durations were measured.",
            "minimum": 0
          },
          "medianSeconds": {
            "type": "number",
            "format": "double",
            "description": "The median, in seconds."
          },
          "p90Seconds": {
            "type": "number",
            "format": "double",
            "description": "The 90th percentile, in seconds."
          }
        }
      },
      "EntryId": {
        "type": "string",
        "description": "The id of one of a Flow's entries. A Step is a visit of an entry."
      },
      "EntryInsight": {
        "type": "object",
        "description": "One of a Flow's entries, across the period's Runs.",
        "required": [
          "entry",
          "steps",
          "runs",
          "revisitedRuns",
          "failedRuns",
          "troubledRuns",
          "outcomes",
          "trouble"
        ],
        "properties": {
          "duration": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/DurationStats",
                "description": "How long its Steps took, a cancelled Run's left out."
              }
            ]
          },
          "entry": {
            "type": "string",
            "description": "The entry's id, as its Flow names it."
          },
          "failedRuns": {
            "type": "integer",
            "format": "int32",
            "description": "The Runs in which one of its Steps failed.",
            "minimum": 0
          },
          "gate": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/GateInsight",
                "description": "Its Gate, if its Steps opened one."
              }
            ]
          },
          "outcomes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/NamedCount"
            },
            "description": "How its Steps ended, most often first."
          },
          "revisitedRuns": {
            "type": "integer",
            "format": "int32",
            "description": "The Runs that visited it more than once: sent back to it, or started\nover.",
            "minimum": 0
          },
          "runs": {
            "type": "integer",
            "format": "int32",
            "description": "The Runs that visited it.",
            "minimum": 0
          },
          "steps": {
            "type": "integer",
            "format": "int32",
            "description": "Its Steps.",
            "minimum": 0
          },
          "tokens": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/TokenCounts",
                "description": "The tokens its agent Steps used, if any recorded usage."
              }
            ]
          },
          "trouble": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TroubleRun"
            },
            "description": "The newest Runs where it failed or was visited more than once."
          },
          "troubledRuns": {
            "type": "integer",
            "format": "int32",
            "description": "The Runs in which one of its Steps failed or that visited it more\nthan once, each counted once.",
            "minimum": 0
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "description": "A plain old json error response for use with axum.\nyup, thats it.",
        "required": ["message"],
        "properties": {
          "message": {
            "type": "string",
            "description": "Message to explain failure"
          }
        }
      },
      "FlowInsight": {
        "type": "object",
        "description": "The Runs of one Flow.",
        "required": ["counts"],
        "properties": {
          "counts": {
            "$ref": "#/components/schemas/OutcomeCounts",
            "description": "How its Runs went."
          },
          "flow": {
            "type": ["string", "null"],
            "description": "The Flow's name; none for Runs recorded before the Flow was kept."
          }
        }
      },
      "FlowSummary": {
        "type": "object",
        "description": "A Flow a person can start a Run of.",
        "required": ["name", "description", "repository"],
        "properties": {
          "description": {
            "type": "string",
            "description": "What it does, for a person."
          },
          "name": {
            "type": "string",
            "description": "Its name, which a Run of it is started with."
          },
          "repository": {
            "type": "boolean",
            "description": "Whether a Run of it works on a GitHub repository, which starting it\nmust name."
          }
        }
      },
      "FlowsResponse": {
        "type": "object",
        "description": "The Flows a Run can be started of.",
        "required": ["flows"],
        "properties": {
          "flows": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FlowSummary"
            },
            "description": "The Flows, by name."
          }
        }
      },
      "Gate": {
        "type": "object",
        "description": "A question a Step's end puts to a person. The Run waits for the answer.",
        "required": ["question", "answers", "openedAt"],
        "properties": {
          "answer": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/GateAnswer",
                "description": "The person's answer; none while the Run waits."
              }
            ]
          },
          "answers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Outcome"
            },
            "description": "The answers it offers, in the Flow's order."
          },
          "openedAt": {
            "type": "string",
            "format": "date-time",
            "description": "When the Run started waiting."
          },
          "question": {
            "type": "string",
            "description": "The question."
          }
        }
      },
      "GateAnswer": {
        "type": "object",
        "description": "A person's answer to a Gate.",
        "required": ["answer", "answeredAt"],
        "properties": {
          "answer": {
            "$ref": "#/components/schemas/Outcome",
            "description": "The answer, one the Gate offered: the outcome the Flow routes."
          },
          "answeredAt": {
            "type": "string",
            "format": "date-time",
            "description": "When they answered."
          },
          "note": {
            "type": ["string", "null"],
            "description": "What the person added, for the Run's later Steps to read."
          },
          "userId": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/MacroUserIdStr",
                "description": "Who answered; none once their account is gone."
              }
            ]
          }
        }
      },
      "GateInsight": {
        "type": "object",
        "description": "A Gate's questions and their answers.",
        "required": ["opened", "answered", "answers"],
        "properties": {
          "answered": {
            "type": "integer",
            "format": "int32",
            "description": "Gates a person answered.",
            "minimum": 0
          },
          "answers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/NamedCount"
            },
            "description": "How often each answer was given, most given first."
          },
          "opened": {
            "type": "integer",
            "format": "int32",
            "description": "Gates opened.",
            "minimum": 0
          },
          "wait": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/DurationStats",
                "description": "How long people took to answer."
              }
            ]
          }
        }
      },
      "HandBackRequest": {
        "type": "object",
        "description": "Request body for handing back an agent Step's result.",
        "required": ["outcome", "text"],
        "properties": {
          "outcome": {
            "$ref": "#/components/schemas/Outcome",
            "description": "How the Step ended: one of the outcomes it offers."
          },
          "text": {
            "type": "string",
            "description": "What the agent produced, for the Run's later Steps and for people."
          }
        }
      },
      "InsightDay": {
        "type": "object",
        "description": "The Runs created on one day of the period.",
        "required": ["date", "counts"],
        "properties": {
          "counts": {
            "$ref": "#/components/schemas/OutcomeCounts",
            "description": "How its Runs went."
          },
          "date": {
            "type": "string",
            "format": "date",
            "description": "The day, in the period's time zone."
          }
        }
      },
      "LinkTaskRequest": {
        "type": "object",
        "description": "Request body for linking a Run to a task.",
        "required": ["taskId"],
        "properties": {
          "taskId": {
            "type": "string",
            "format": "uuid",
            "description": "The task document's id."
          }
        }
      },
      "MacroUserIdStr": {
        "type": "string"
      },
      "NamedCount": {
        "type": "object",
        "description": "A name a Flow gives (an outcome, a Gate's answer) and how often it came.",
        "required": ["name", "count"],
        "properties": {
          "count": {
            "type": "integer",
            "format": "int32",
            "description": "How many times.",
            "minimum": 0
          },
          "name": {
            "type": "string",
            "description": "The name, as the Flow writes it."
          }
        }
      },
      "Outcome": {
        "type": "string",
        "description": "How a Step ended, in the words of its Flow (`done`, `clean`, `blockers`,\n...). The Flow decides where each outcome takes the Run."
      },
      "OutcomeCounts": {
        "type": "object",
        "description": "How many Runs went each way: still going, or ended with each outcome.",
        "required": [
          "running",
          "success",
          "manual",
          "blocked",
          "failed",
          "cancelled"
        ],
        "properties": {
          "blocked": {
            "type": "integer",
            "format": "int32",
            "description": "Runs that ran out of visits, or of Steps, with nowhere to go.",
            "minimum": 0
          },
          "cancelled": {
            "type": "integer",
            "format": "int32",
            "description": "Runs a person cancelled.",
            "minimum": 0
          },
          "failed": {
            "type": "integer",
            "format": "int32",
            "description": "Runs that ended failed.",
            "minimum": 0
          },
          "manual": {
            "type": "integer",
            "format": "int32",
            "description": "Runs that ended for a person to take over.",
            "minimum": 0
          },
          "running": {
            "type": "integer",
            "format": "int32",
            "description": "Runs still going.",
            "minimum": 0
          },
          "success": {
            "type": "integer",
            "format": "int32",
            "description": "Runs whose Flow reached its successful end.",
            "minimum": 0
          }
        }
      },
      "Repository": {
        "type": "object",
        "description": "The GitHub repository a Run works on.",
        "required": ["url", "baseBranch"],
        "properties": {
          "baseBranch": {
            "type": "string",
            "description": "The branch the Run's work starts from and proposes its change to: the\nrepository's default when the Run started."
          },
          "url": {
            "type": "string",
            "description": "Its `https://github.com/owner/name` URL."
          }
        }
      },
      "Run": {
        "type": "object",
        "description": "One Run of a Flow.",
        "required": ["id", "request", "userId", "createdAt"],
        "properties": {
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "When the Run was created."
          },
          "end": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/RunEnd",
                "description": "How and when it ended; none while it runs."
              }
            ]
          },
          "id": {
            "$ref": "#/components/schemas/RunId",
            "description": "The Run's id, also its Temporal workflow id."
          },
          "repository": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/Repository",
                "description": "The GitHub repository the Run works on; none for a Run that works on\nno code."
              }
            ]
          },
          "request": {
            "type": "string",
            "description": "What the Run was asked to do."
          },
          "taskId": {
            "type": ["string", "null"],
            "format": "uuid",
            "description": "The Macro task the Run works on: its task document's id. None when\nthe Run has no task, or its task was deleted."
          },
          "userId": {
            "$ref": "#/components/schemas/MacroUserIdStr",
            "description": "Who started the Run: its agent Steps run as them."
          }
        }
      },
      "RunDetail": {
        "type": "object",
        "description": "A Run and the Steps it took.",
        "required": ["run", "steps"],
        "properties": {
          "run": {
            "$ref": "#/components/schemas/Run",
            "description": "The Run."
          },
          "steps": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Step"
            },
            "description": "Its Steps, in the order they started."
          }
        }
      },
      "RunEnd": {
        "type": "object",
        "description": "A Run that has ended: how, and when.",
        "required": ["outcome", "endedAt"],
        "properties": {
          "endedAt": {
            "type": "string",
            "format": "date-time",
            "description": "When it ended."
          },
          "outcome": {
            "$ref": "#/components/schemas/RunOutcome",
            "description": "How the Run ended."
          }
        }
      },
      "RunId": {
        "type": "string",
        "format": "uuid",
        "description": "A Run's id."
      },
      "RunInsights": {
        "type": "object",
        "description": "How a person's Runs went over a period.",
        "required": [
          "from",
          "to",
          "timeZone",
          "runCap",
          "capped",
          "totals",
          "days",
          "flows",
          "entries",
          "usage"
        ],
        "properties": {
          "capped": {
            "type": "boolean",
            "description": "Whether the period had more Runs than that, so the oldest are left\nout."
          },
          "days": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/InsightDay"
            },
            "description": "The Runs created each day of the period, every day listed."
          },
          "entries": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EntryInsight"
            },
            "description": "The Flows' entries the Runs visited, in their Flows' order."
          },
          "flow": {
            "type": ["string", "null"],
            "description": "The Flow read, or none for every Flow."
          },
          "flows": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FlowInsight"
            },
            "description": "The Runs of each Flow, most Runs first."
          },
          "from": {
            "type": "string",
            "format": "date",
            "description": "The period's first day."
          },
          "runCap": {
            "type": "integer",
            "format": "int32",
            "description": "The most Runs read: the newest in the period.",
            "minimum": 0
          },
          "runDuration": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/DurationStats",
                "description": "How long Runs took from creation to their end, cancelled Runs and\nRuns still going left out."
              }
            ]
          },
          "timeZone": {
            "type": "string",
            "description": "The time zone its days are in."
          },
          "to": {
            "type": "string",
            "format": "date",
            "description": "Its last day."
          },
          "totals": {
            "$ref": "#/components/schemas/OutcomeCounts",
            "description": "How the Runs went."
          },
          "usage": {
            "$ref": "#/components/schemas/UsageInsight",
            "description": "What the agent Steps used."
          }
        }
      },
      "RunLink": {
        "type": "object",
        "description": "One of the period's Runs, to link to.",
        "required": ["id", "title", "createdAt"],
        "properties": {
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "When it was created."
          },
          "id": {
            "$ref": "#/components/schemas/RunId",
            "description": "The Run."
          },
          "outcome": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/RunOutcome",
                "description": "How it ended; none while it goes."
              }
            ]
          },
          "title": {
            "type": "string",
            "description": "The first line of its request."
          }
        }
      },
      "RunOutcome": {
        "type": "string",
        "description": "How a Run ended.",
        "enum": ["success", "manual", "blocked", "failed", "cancelled"]
      },
      "RunTokens": {
        "type": "object",
        "description": "One of the period's Runs and the tokens its agent Steps used.",
        "required": ["run", "tokens"],
        "properties": {
          "run": {
            "$ref": "#/components/schemas/RunLink",
            "description": "The Run."
          },
          "tokens": {
            "$ref": "#/components/schemas/TokenCounts",
            "description": "What its agents used."
          }
        }
      },
      "Step": {
        "type": "object",
        "description": "One visit of one of a Run's entries.",
        "required": ["seq", "entry", "visit", "startedAt"],
        "properties": {
          "end": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/StepEnd",
                "description": "How and when it ended; none while it runs."
              }
            ]
          },
          "entry": {
            "$ref": "#/components/schemas/EntryId",
            "description": "The entry the Step visits."
          },
          "gate": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/Gate",
                "description": "The question its end put to a person, if its entry has a Gate."
              }
            ]
          },
          "seq": {
            "type": "integer",
            "format": "int32",
            "description": "The Step's place among the Run's Steps, from 1.",
            "minimum": 0
          },
          "startedAt": {
            "type": "string",
            "format": "date-time",
            "description": "When the Step started."
          },
          "visit": {
            "type": "integer",
            "format": "int32",
            "description": "Which visit of the entry it is, from 1.",
            "minimum": 0
          }
        }
      },
      "StepEnd": {
        "type": "object",
        "description": "A Step that has ended: its outcome, what it produced, and when.",
        "required": ["outcome", "output", "endedAt"],
        "properties": {
          "endedAt": {
            "type": "string",
            "format": "date-time",
            "description": "When it ended."
          },
          "outcome": {
            "$ref": "#/components/schemas/Outcome",
            "description": "How the Step ended."
          },
          "output": {
            "type": "string",
            "description": "What the Step produced, for a person to read."
          }
        }
      },
      "TaskRunsResponse": {
        "type": "object",
        "description": "A task's Runs, as the caller sees them.",
        "required": ["runs"],
        "properties": {
          "runs": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RunDetail"
            },
            "description": "The caller's Runs on the task, newest first: at most the newest 50."
          }
        }
      },
      "TokenCounts": {
        "type": "object",
        "description": "Tokens agent model calls used.",
        "required": ["input", "output", "cacheRead", "cacheWrite"],
        "properties": {
          "cacheRead": {
            "type": "integer",
            "format": "int64",
            "description": "Input tokens read from the prompt cache.",
            "minimum": 0
          },
          "cacheWrite": {
            "type": "integer",
            "format": "int64",
            "description": "Input tokens written to the prompt cache.",
            "minimum": 0
          },
          "input": {
            "type": "integer",
            "format": "int64",
            "description": "Input tokens, besides those read from or written to the prompt cache.",
            "minimum": 0
          },
          "output": {
            "type": "integer",
            "format": "int64",
            "description": "Output tokens.",
            "minimum": 0
          }
        }
      },
      "TroubleRun": {
        "type": "object",
        "description": "A Run where an entry failed or was visited more than once.",
        "required": ["run", "failed", "visits"],
        "properties": {
          "failed": {
            "type": "boolean",
            "description": "Whether one of the entry's Steps in it failed."
          },
          "run": {
            "$ref": "#/components/schemas/RunLink",
            "description": "The Run."
          },
          "visits": {
            "type": "integer",
            "format": "int32",
            "description": "How many times it visited the entry.",
            "minimum": 0
          }
        }
      },
      "UsageInsight": {
        "type": "object",
        "description": "What the period's agent Steps used.",
        "required": [
          "agentSteps",
          "measuredSteps",
          "measuredRuns",
          "tokens",
          "heaviest"
        ],
        "properties": {
          "agentSteps": {
            "type": "integer",
            "format": "int32",
            "description": "Steps an agent worked on, in a session.",
            "minimum": 0
          },
          "heaviest": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RunTokens"
            },
            "description": "The Runs that used the most tokens, most first."
          },
          "measuredRuns": {
            "type": "integer",
            "format": "int32",
            "description": "Runs with any usage recorded.",
            "minimum": 0
          },
          "measuredSteps": {
            "type": "integer",
            "format": "int32",
            "description": "Those whose session has usage recorded. An agent that runs on a\nperson's own computer records none.",
            "minimum": 0
          },
          "tokens": {
            "$ref": "#/components/schemas/TokenCounts",
            "description": "What they used, summed."
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "factory",
      "description": "Runs of the software factory's Flows"
    }
  ]
}
