  "query": "\n            SELECT\n                id, request, user_id, created_at, task_id, repo_url, base_branch, outcome, ended_at\n            FROM factory_run\n            WHERE task_id = $1 AND user_id = $2\n            ORDER BY created_at DESC, id DESC\n            LIMIT $3\n            ",
