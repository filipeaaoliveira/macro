  "query": "\n            SELECT run_id, seq, started_at, outcome\n            FROM factory_review_round rr\n            WHERE run_id = ANY($1) AND seq >= (SELECT COALESCE(k.first_seq, 1) FROM factory_run k WHERE k.id = rr.run_id)\n            ORDER BY run_id, seq\n            ",
