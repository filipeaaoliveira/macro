{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT s.scorer, s.score, s.reason, s.model, s.judged_at,\n                   l.passed AS \"passed?\", l.labelled_at AS \"labelled_at?\"\n            FROM factory_run_score s\n            LEFT JOIN factory_scorer_label l ON l.run_id = s.run_id AND l.scorer = s.scorer\n            WHERE s.run_id = $1\n            ORDER BY s.scorer\n            ",
