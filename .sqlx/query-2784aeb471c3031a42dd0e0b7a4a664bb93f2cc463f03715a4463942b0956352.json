  "query": "\n            SELECT id, benchmark, agents AS \"agents: Json<serde_json::Value>\", created_at\n            FROM factory_benchmark_suite\n            WHERE user_id = $1 AND created_at >= $2 AND created_at < $3\n            ORDER BY created_at DESC, id DESC\n            LIMIT $4\n            ",
