{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT scorer,\n                   count(*) AS \"judged!\",\n                   count(*) FILTER (WHERE score >= $2) AS \"passed!\",\n                   avg(score) AS \"mean_score!\"\n            FROM factory_run_score\n            WHERE run_id = ANY($1)\n            GROUP BY scorer\n            ORDER BY scorer\n            ",
