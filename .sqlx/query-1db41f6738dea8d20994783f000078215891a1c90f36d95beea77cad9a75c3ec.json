  "db_name": "PostgreSQL",
  "query": "\n            SELECT t.suite_id, t.task, s.benchmark,\n                   t.scored_at IS NOT NULL AS \"scored!\",\n                   t.branch_deleted_at IS NOT NULL AS \"branch_deleted!\"\n            FROM factory_benchmark_trial t\n            JOIN factory_benchmark_suite s ON s.id = t.suite_id\n            WHERE t.run_id = $1\n            ",
