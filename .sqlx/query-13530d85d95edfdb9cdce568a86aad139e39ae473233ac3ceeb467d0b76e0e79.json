{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT\n                s.entry,\n                s.visit,\n                s.started_at,\n                s.outcome,\n                s.output,\n                s.ended_at,\n                g.question AS \"question?\",\n                g.answers AS \"answers?\",\n                g.opened_at AS \"opened_at?\",\n                g.answer,\n                g.note,\n                g.user_id,\n                g.answered_at\n            FROM factory_step s\n            LEFT JOIN factory_gate g\n                ON g.run_id = s.run_id AND g.entry = s.entry AND g.visit = s.visit\n            WHERE s.run_id = $1\n            ORDER BY s.started_at, s.entry, s.visit\n            ",
