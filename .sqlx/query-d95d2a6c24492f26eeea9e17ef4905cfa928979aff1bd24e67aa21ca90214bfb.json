  "query": "\n            SELECT\n                run_id, seq, round_seq, problem, fix_status, ruling,\n                kind = 'dismissed' AS \"dismissed!\"\n            FROM factory_review_finding\n            WHERE run_id = ANY($1) AND kind IN ('blocker', 'dismissed')\n            ORDER BY run_id, seq, place\n            ",
