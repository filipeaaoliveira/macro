  "query": "\n            SELECT\n                s.run_id,\n                s.entry,\n                s.visit,\n                r.user_id,\n                s.offered AS \"offered!\",\n                s.ended_at IS NOT NULL AS \"ended!\"\n            FROM factory_step s\n            JOIN factory_run r ON r.id = s.run_id\n            WHERE s.session_id = $1\n            ",
