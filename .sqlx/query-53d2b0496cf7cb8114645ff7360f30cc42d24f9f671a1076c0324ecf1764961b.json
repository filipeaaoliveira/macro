  "db_name": "PostgreSQL",
  "query": "\n            SELECT w.run_id, w.seq, s.started_at, w.recorded_at, w.verdict\n            FROM factory_ci_wait w\n            JOIN factory_step s ON s.run_id = w.run_id AND s.seq = w.seq\n            WHERE w.run_id = ANY($1)\n            ORDER BY w.run_id, w.seq\n            ",
