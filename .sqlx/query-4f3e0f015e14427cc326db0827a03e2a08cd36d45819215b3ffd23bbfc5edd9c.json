{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT a.run_id, a.seq, a.round_seq, s.role, s.agent\n            FROM factory_reviewer_answer a\n            JOIN factory_step s ON s.run_id = a.run_id AND s.seq = a.seq\n            WHERE a.run_id = ANY($1)\n            ORDER BY a.run_id, a.seq\n            ",
